# Environment configuration for the payroll_pipeline pipeline.
# Copy to .env and fill in real values. .env is gitignored.

# --- AWS ------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_PROFILE=
ENVIRONMENT=dev

# --- Data product ---------------------------------------------------------
DATA_PRODUCT=payroll_pipeline
DATA_BUCKET=

# --- Spark (local development) --------------------------------------------
SPARK_MASTER=local[*]
